# ---- Image uploads (optional but recommended) ----
# With these two set, staff photo uploads go to Cloudinary. Without them, images are
# stored inside Firestore documents, which is limited to about 1 MB per page.
# Create an UNSIGNED upload preset in Cloudinary (Settings > Upload) and restrict it
# to image formats and a size limit. These two values are public by design.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# ---- Only for the optional Node server (server.ts). Never prefix these with VITE_. ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Comma-separated origins allowed to call /api from another site. Leave empty for same-origin only.
ALLOWED_ORIGINS=
