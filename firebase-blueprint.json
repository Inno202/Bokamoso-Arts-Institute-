{
  "entities": {
    "User": {
      "title": "User",
      "description": "A user in the system with their role.",
      "type": "object",
      "properties": {
        "email": {
          "type": "string"
        },
        "role": {
          "type": "string",
          "enum": ["SUPER_ADMIN", "CEO", "FINANCE_MANAGER", "PUBLIC_RELATIONS", "TICKET_SCANNER", "USER"]
        }
      },
      "required": ["email", "role"]
    },
    "Ticket": {
      "title": "Ticket",
      "description": "A ticket purchased by a user.",
      "type": "object",
      "properties": {
        "tourId": {
          "type": "string"
        },
        "ticketType": {
          "type": "string"
        },
        "buyerEmail": {
          "type": "string"
        },
        "buyerId": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": ["VALID", "SCANNED", "CANCELLED"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["tourId", "ticketType", "buyerEmail", "buyerId", "status", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/User"
      },
      "description": "Stores user profiles including their roles for RBAC."
    },
    "/tickets/{ticketId}": {
      "schema": {
        "$ref": "#/entities/Ticket"
      },
      "description": "Stores tickets generated after a successful purchase."
    }
  }
}
