rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isSignedIn() && getUserData().role == role;
    }

    function isAnyAdmin() {
      return hasRole('SUPER_ADMIN') || hasRole('CEO') || hasRole('FINANCE_MANAGER') || hasRole('PUBLIC_RELATIONS');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Users collection
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isOwner(uid) || hasRole('SUPER_ADMIN');
      allow delete: if hasRole('SUPER_ADMIN');
    }

    // Tickets collection
    match /tickets/{ticketId} {
      allow read: if isSignedIn(); // Allow reading tickets for demo stats
      // Tickets only created via server API
      allow write: if hasRole('SUPER_ADMIN');
    }

    // Ticket scans
    match /ticket_scanned/{scanId} {
      allow read: if isSignedIn();
      // Only scanner or admin can write via server
      allow write: if hasRole('SUPER_ADMIN');
    }

    // Events collection
    match /events/{eventId} {
      allow read: if true;
      allow write: if hasRole('SUPER_ADMIN') || hasRole('CEO') || hasRole('PUBLIC_RELATIONS');
    }

    // Team collection
    match /team/{memberId} {
      allow read: if true;
      allow write: if hasRole('SUPER_ADMIN') || hasRole('CEO') || hasRole('PUBLIC_RELATIONS');
    }

    // Content collection
    match /content/{docId} {
      allow read: if true;
      allow write: if hasRole('SUPER_ADMIN') || hasRole('CEO') || hasRole('PUBLIC_RELATIONS');
    }

    // Sessions collection
    match /sessions/{sessionId} {
      allow read, write: if false; // Server only
    }

    // Cart collection
    match /cart/{cartId} {
      allow read, write: if isSignedIn() && request.auth.uid == cartId;
    }
  }
}
