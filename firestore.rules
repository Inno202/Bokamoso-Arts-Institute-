rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isSignedIn() && getUserData().role == role;
    }

    function isAnyAdmin() {
      return hasRole('SUPER_ADMIN') || hasRole('PRO') || hasRole('CEO') || hasRole('FINANCE_MANAGER');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Users collection
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isOwner(uid) || isAnyAdmin();
      allow delete: if isAnyAdmin();
    }

    // Tickets collection
    match /tickets/{ticketId} {
      allow read: if isSignedIn(); // Allow reading tickets for demo stats
      allow create: if isSignedIn(); // Allow client side checkout checkout
      allow update: if isSignedIn(); // Allow client side scanner to update ticket status
      allow delete: if hasRole('SUPER_ADMIN');
    }

    // Ticket scans
    match /ticket_scanned/{scanId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn(); // Allow scanner to log scans
      allow update: if hasRole('SUPER_ADMIN');
      allow delete: if hasRole('SUPER_ADMIN');
    }

    // Events collection
    match /events/{eventId} {
      allow read: if true;
      allow write: if hasRole('SUPER_ADMIN') || hasRole('PRO') || hasRole('CEO');
    }

    // Team collection
    match /team/{memberId} {
      allow read: if true;
      allow write: if hasRole('SUPER_ADMIN') || hasRole('CEO') || hasRole('PRO');
    }

    // Content collection
    match /content/{docId} {
      allow read: if true;
      allow write: if hasRole('SUPER_ADMIN') || hasRole('CEO') || hasRole('PRO');
    }

    // About collection
    match /about/{docId} {
      allow read: if true;
      allow write: if isAnyAdmin();
    }
    match /about {
      allow read: if true;
    }

    // Work collection
    match /work/{docId} {
      allow read: if true;
      allow write: if isAnyAdmin();
    }
    match /work {
      allow read: if true;
    }

    // Sessions collection
    match /sessions/{sessionId} {
      allow read, write: if false; // Server only
    }

    // Cart collection
    match /cart/{cartId} {
      allow read, write: if isSignedIn() && request.auth.uid == cartId;
    }
  }
}
