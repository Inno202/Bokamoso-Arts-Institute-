rules_version = '2';

// Bokamoso Arts Institute — Firestore security rules.
//
// Deploy with:  npx firebase-tools deploy --only firestore
// Test with:    npm run test:rules
//
// Anything not matched below is denied.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function profilePath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    // A role only counts while the account is active.
    function hasAnyRole(roles) {
      return isSignedIn()
        && exists(profilePath())
        && get(profilePath()).data.get('isActive', true) == true
        && get(profilePath()).data.role in roles;
    }

    function isSuperAdmin()   { return hasAnyRole(['SUPER_ADMIN']); }
    function isUserAdmin()    { return hasAnyRole(['SUPER_ADMIN', 'CEO']); }
    function isAnyAdmin()     { return hasAnyRole(['SUPER_ADMIN', 'PRO', 'CEO', 'FINANCE_MANAGER']); }
    function isEventManager() { return hasAnyRole(['SUPER_ADMIN', 'PRO', 'CEO']); }
    function isScanner()      { return hasAnyRole(['SUPER_ADMIN', 'PRO', 'TICKET_SCANNER']); }
    function isStaff()        { return hasAnyRole(['SUPER_ADMIN', 'PRO', 'CEO', 'FINANCE_MANAGER', 'TICKET_SCANNER']); }

    function validRole(role) {
      return role in ['SUPER_ADMIN', 'PRO', 'CEO', 'FINANCE_MANAGER', 'TICKET_SCANNER', 'USER'];
    }

    function tokenEmail() {
      return request.auth.token.get('email', '');
    }

    // True only if the person typed their password (or used Google) within the last
    // 8 hours. A stolen, long-lived session cannot renew this, so the most damaging
    // actions (handing out roles, removing accounts) need a fresh sign-in.
    function recentSignIn() {
      return request.auth.token.auth_time is number
        && request.time < timestamp.value(request.auth.token.auth_time * 1000) + duration.value(8, 'h');
    }

    // ---------- users ----------

    function validNewProfile(data) {
      return data.keys().hasOnly(['email', 'displayName', 'role', 'isActive', 'photoURL', 'createdAt'])
        && data.keys().hasAll(['email', 'displayName', 'role', 'isActive', 'createdAt'])
        && data.email is string && data.email.size() <= 320
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100
        && validRole(data.role)
        && data.isActive is bool
        && data.createdAt == request.time;
    }

    match /users/{uid} {
      allow get: if isOwner(uid) || isUserAdmin();
      allow list: if isUserAdmin();

      // Self sign-up is always a plain, active USER. Only admins hand out roles.
      allow create: if validNewProfile(request.resource.data) && (
        (isOwner(uid)
          && request.resource.data.role == 'USER'
          && request.resource.data.isActive == true
          && request.resource.data.email == tokenEmail())
        || (recentSignIn() && isSuperAdmin())
        || (recentSignIn() && hasAnyRole(['CEO']) && request.resource.data.role != 'SUPER_ADMIN')
      );

      allow update: if
        // Owners may edit their own display details, never role or status.
        (isOwner(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'photoURL', 'lastLogin'])
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() >= 1
          && request.resource.data.displayName.size() <= 100)
        // Super admins manage roles and status, but not their own (no self lock-out).
        || (recentSignIn()
          && isSuperAdmin()
          && request.auth.uid != uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'isActive', 'displayName'])
          && validRole(request.resource.data.role)
          && request.resource.data.get('isActive', true) is bool)
        // CEOs may deactivate or reactivate anyone below super admin.
        || (recentSignIn()
          && hasAnyRole(['CEO'])
          && request.auth.uid != uid
          && resource.data.role != 'SUPER_ADMIN'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isActive'])
          && request.resource.data.isActive is bool);

      allow delete: if recentSignIn() && isSuperAdmin() && request.auth.uid != uid;
    }

    // ---------- events ----------

    function validEvent(data) {
      return data.name is string && data.name.size() >= 1 && data.name.size() <= 200
        && data.venue is string && data.venue.size() <= 200
        && data.city is string && data.city.size() <= 100
        && data.date is timestamp
        && data.price is number && data.price >= 0 && data.price <= 100000
        && data.capacity is int && data.capacity >= 1 && data.capacity <= 1000000
        && data.ticketsSold is int && data.ticketsSold >= 0
        && data.status is string && data.status.size() <= 40
        && data.get('description', '') is string && data.get('description', '').size() <= 5000
        // Each event is priced in one currency; events without one are in rand.
        && data.get('currency', 'ZAR') in ['ZAR', 'BWP', 'SZL', 'LSL', 'NAD', 'USD', 'EUR', 'GBP']
        // Shows sold by an outside seller (for example abroad) link to that seller's page.
        && data.get('ticketUrl', '') is string
        && (data.get('ticketUrl', '') == '' || data.get('ticketUrl', '').matches('^https://[^\\s]{4,490}$'))
        && data.get('ticketProvider', '') is string && data.get('ticketProvider', '').size() <= 60;
    }

    function eventPath(eventId) {
      return /databases/$(database)/documents/events/$(eventId);
    }

    // How many tickets one account holds for one event.
    function holdingPath(uid, eventId) {
      return /databases/$(database)/documents/ticket_holdings/$(uid + '_' + eventId);
    }

    function orderPath(orderId) {
      return /databases/$(database)/documents/orders/$(orderId);
    }

    match /events/{eventId} {
      allow read: if true;
      allow create: if isEventManager()
        && validEvent(request.resource.data)
        && request.resource.data.ticketsSold == 0;
      allow update: if
        // A buyer's checkout may only move the sold counter, upward, within capacity,
        // and only in the same write that records what this account now holds.
        // (Checked first, so an ordinary checkout costs no staff-profile lookups.)
        (isSignedIn()
          && resource.data.status == 'On Sale'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ticketsSold'])
          && request.resource.data.ticketsSold is int
          && request.resource.data.ticketsSold > resource.data.ticketsSold
          && request.resource.data.ticketsSold <= resource.data.ticketsSold + 10
          && request.resource.data.ticketsSold <= resource.data.capacity
          && getAfter(holdingPath(request.auth.uid, eventId)).data.updatedAt == request.time)
        || (isEventManager() && validEvent(request.resource.data));
      allow delete: if isEventManager();
    }

    // ---------- checkout ----------
    //
    // One checkout for one event writes four things together, and each is only
    // accepted if the others agree with it:
    //   events/{id}.ticketsSold      goes up by N
    //   ticket_holdings/{uid}_{id}   goes up by the same N, and never above 10
    //   orders/{uid}_{id}_{holding}  records N ticket references at the event's price
    //   tickets/{ref}                one per reference listed in that order
    // So tickets can never outnumber the sold counter, an event cannot be oversold,
    // and one account cannot hold more than 10 tickets for an event.

    match /ticket_holdings/{holdingId} {
      allow get: if isSignedIn() && (holdingId.matches('^' + request.auth.uid + '_.*') || isAnyAdmin());
      allow list: if isAnyAdmin();
      allow create, update: if isSignedIn()
        && request.resource.data.keys().hasOnly(['buyerId', 'eventId', 'count', 'updatedAt'])
        && request.resource.data.buyerId == request.auth.uid
        && request.resource.data.eventId is string
        && holdingId == request.auth.uid + '_' + request.resource.data.eventId
        && request.resource.data.updatedAt == request.time
        && request.resource.data.count is int
        && request.resource.data.count <= 10
        && request.resource.data.count ==
             (resource == null ? 0 : resource.data.count)
             + getAfter(eventPath(request.resource.data.eventId)).data.ticketsSold
             - get(eventPath(request.resource.data.eventId)).data.ticketsSold;
      allow delete: if isSuperAdmin();
    }

    match /orders/{orderId} {
      allow get: if isSignedIn() && ((resource != null && resource.data.buyerId == request.auth.uid) || isAnyAdmin());
      allow list: if isSignedIn() && (resource.data.buyerId == request.auth.uid || isAnyAdmin());
      // Orders are a permanent record: created once at checkout, never edited.
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['buyerId', 'buyerEmail', 'eventId', 'eventName', 'unitPrice', 'currency', 'quantity', 'ticketIds', 'createdAt'])
        && request.resource.data.buyerId == request.auth.uid
        && request.resource.data.buyerEmail == tokenEmail()
        // Only people who have confirmed their email can book (Google sign-ins are confirmed).
        && request.auth.token.get('email_verified', false) == true
        && request.resource.data.createdAt == request.time
        && request.resource.data.eventId is string
        && request.resource.data.quantity is int
        && request.resource.data.quantity >= 1
        && request.resource.data.quantity <= 10
        && request.resource.data.ticketIds is list
        && request.resource.data.ticketIds.size() == request.resource.data.quantity
        && request.resource.data.ticketIds.toSet().size() == request.resource.data.quantity
        && request.resource.data.eventName is string
        && request.resource.data.eventName.size() <= 200
        && get(eventPath(request.resource.data.eventId)).data.status == 'On Sale'
        // Tickets for shows sold by an outside seller are never issued here.
        && get(eventPath(request.resource.data.eventId)).data.get('ticketUrl', '') == ''
        && request.resource.data.get('currency', 'ZAR') == get(eventPath(request.resource.data.eventId)).data.get('currency', 'ZAR')
        && request.resource.data.unitPrice == get(eventPath(request.resource.data.eventId)).data.price
        && getAfter(eventPath(request.resource.data.eventId)).data.ticketsSold
             == get(eventPath(request.resource.data.eventId)).data.ticketsSold + request.resource.data.quantity
        // The order's id is fixed by the account's new holding, so one checkout
        // can never be recorded as two orders.
        && orderId == request.auth.uid + '_' + request.resource.data.eventId + '_'
             + string(getAfter(holdingPath(request.auth.uid, request.resource.data.eventId)).data.count);
      allow update: if false;
      allow delete: if isSuperAdmin();
    }

    // ---------- tickets ----------

    function ticketMatchesOrder(ticketId, ticket, order) {
      return ticketId in order.ticketIds
        && order.createdAt == request.time
        && order.buyerId == request.auth.uid
        && ticket.buyerId == order.buyerId
        && ticket.buyerEmail == order.buyerEmail
        && ticket.eventId == order.eventId
        && ticket.eventName == order.eventName
        && ticket.price == order.unitPrice
        && ticket.get('currency', 'ZAR') == order.get('currency', 'ZAR');
    }

    match /tickets/{ticketId} {
      allow get: if isSignedIn()
        && ((resource != null && resource.data.buyerId == request.auth.uid) || isStaff());
      // Buyers can only query their own tickets; admins can report on all of them.
      allow list: if isSignedIn()
        && (resource.data.buyerId == request.auth.uid || isAnyAdmin());

      // A ticket exists only as one of the references listed in the buyer's order,
      // copying that order's event, price and buyer. The order rule has already
      // checked those against the event, so this check stays small: a single write
      // may only evaluate a limited amount of rule logic, and a full order has 10 tickets.
      allow create: if isSignedIn()
        && ticketId.matches('^BAI-[A-HJ-NP-Z2-9]{12}$')
        && request.resource.data.keys().hasOnly(['orderId', 'eventId', 'eventName', 'ticketType', 'buyerId', 'buyerEmail', 'price', 'currency', 'quantity', 'status', 'createdAt'])
        && request.resource.data.status == 'VALID'
        && request.resource.data.quantity == 1
        && request.resource.data.ticketType == 'General Admission'
        && request.resource.data.createdAt == request.time
        && ticketMatchesOrder(ticketId, request.resource.data, getAfter(orderPath(request.resource.data.orderId)).data);

      allow update: if
        // Door staff admit a valid ticket exactly once, together with its scan record.
        // (The cheap checks come first: this rule is also consulted while tickets are
        // being created, and staff-profile lookups there would use up the write's budget.)
        (resource != null
          && resource.data.status == 'VALID'
          && request.resource.data.status == 'SCANNED'
          && isScanner()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'scannedAt', 'scannedBy'])
          && request.resource.data.scannedBy == request.auth.uid
          && request.resource.data.scannedAt == request.time
          && existsAfter(/databases/$(database)/documents/ticket_scanned/$(ticketId))
          // Not for an event that has passed (more than 12 hours after it started).
          && request.time < get(eventPath(resource.data.eventId)).data.date + duration.value(12, 'h'))
        // Super admins may cancel or restore a ticket.
        || (resource != null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
          && request.resource.data.status in ['VALID', 'CANCELLED']
          && isSuperAdmin());

      allow delete: if isSuperAdmin();
    }

    // ---------- ticket scans (one per ticket, keyed by ticket id) ----------

    match /ticket_scanned/{scanId} {
      allow read: if isStaff();
      allow create: if isScanner()
        && request.resource.data.keys().hasOnly(['ticketId', 'eventId', 'buyerEmail', 'scannedAt', 'scannedBy'])
        && request.resource.data.ticketId == scanId
        && request.resource.data.scannedBy == request.auth.uid
        && request.resource.data.scannedAt == request.time
        && get(/databases/$(database)/documents/tickets/$(scanId)).data.status == 'VALID'
        && getAfter(/databases/$(database)/documents/tickets/$(scanId)).data.status == 'SCANNED';
      allow update: if false;
      allow delete: if isSuperAdmin();
    }

    // ---------- site content ----------
    //
    // One document per section of the site. Everyone can read it; only content
    // editors can change it, and every save records who made it and when.

    // Super admins and the CEO edit site content directly. PRO staff need an
    // approved, unexpired request (see content_access below).
    function contentAccessPath(uid) {
      return /databases/$(database)/documents/content_access/$(uid);
    }
    function hasContentAccess() {
      return exists(contentAccessPath(request.auth.uid))
        && get(contentAccessPath(request.auth.uid)).data.status == 'APPROVED'
        && get(contentAccessPath(request.auth.uid)).data.expiresAt > request.time;
    }
    function isContentEditor() {
      return hasAnyRole(['SUPER_ADMIN', 'CEO']) || (hasAnyRole(['PRO']) && hasContentAccess());
    }

    // ---------- site content access requests ----------
    // content_access/{uid}: one record per PRO. They ask; a super admin or the CEO
    // approves for a limited time (at most 7 days), declines, or ends it early.
    match /content_access/{uid} {
      allow get: if isOwner(uid) || isUserAdmin();
      allow list: if isUserAdmin();

      // A PRO asks, or asks again once the last request is no longer waiting.
      allow create, update: if isOwner(uid) && hasAnyRole(['PRO'])
        && (resource == null || resource.data.status != 'PENDING')
        && request.resource.data.keys().hasOnly(['uid', 'name', 'email', 'note', 'status', 'requestedAt'])
        && request.resource.data.uid == uid
        && request.resource.data.status == 'PENDING'
        && request.resource.data.requestedAt == request.time
        && request.resource.data.name is string && request.resource.data.name.size() <= 100
        && request.resource.data.email == tokenEmail()
        && request.resource.data.get('note', '') is string && request.resource.data.get('note', '').size() <= 300;

      // A super admin or the CEO decides; nobody decides on their own access.
      allow update: if isUserAdmin() && request.auth.uid != uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decidedBy', 'decidedAt', 'expiresAt'])
        && request.resource.data.decidedBy == request.auth.uid
        && request.resource.data.decidedAt == request.time
        && (
          (resource.data.status == 'PENDING' && request.resource.data.status == 'APPROVED'
            && request.resource.data.expiresAt is timestamp
            && request.resource.data.expiresAt > request.time
            && request.resource.data.expiresAt <= request.time + duration.value(7, 'd'))
          || (resource.data.status == 'PENDING' && request.resource.data.status == 'DECLINED')
          || (resource.data.status == 'APPROVED' && request.resource.data.status == 'ENDED'
            && request.resource.data.expiresAt == request.time)
        );
      allow delete: if isSuperAdmin();
    }

    match /content/{section} {
      allow read: if true;
      allow create, update: if isContentEditor()
        && section in ['site', 'home', 'about', 'work', 'traditions']
        && request.resource.data.keys().hasOnly(['data', 'updatedAt', 'updatedBy'])
        && request.resource.data.data is map
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if isSuperAdmin();
    }

    // Where the About and Our Work pages kept their content before the content
    // store existed. Still readable as a fallback, no longer writable.
    match /about/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /work/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // ---------- carts ----------

    match /cart/{cartId} {
      allow read, delete: if isOwner(cartId);
      allow create, update: if isOwner(cartId)
        && request.resource.data.keys().hasOnly(['userId', 'items', 'total', 'updatedAt'])
        && request.resource.data.userId == cartId
        && request.resource.data.items is list
        && request.resource.data.items.size() <= 25;
    }
  }
}
