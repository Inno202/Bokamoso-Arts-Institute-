rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'SUPER_ADMIN';
    }

    function isScanner() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'TICKET_SCANNER';
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }
    
    function existing() {
      return resource.data;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['email', 'role']) 
             && data.keys().size() == 2
             && data.email is string && data.email.size() <= 100
             && data.role is string && data.role.size() <= 30;
    }

    function isValidTicket(data) {
      return data.keys().hasAll(['tourId', 'ticketType', 'buyerEmail', 'buyerId', 'status', 'createdAt'])
             && data.keys().size() == 6
             && data.tourId is string && data.tourId.size() <= 100
             && data.ticketType is string && data.ticketType.size() <= 100
             && data.buyerEmail is string && data.buyerEmail.size() <= 100
             && data.buyerId is string && data.buyerId.size() <= 100
             && data.status is string && data.status.size() <= 30
             && data.createdAt == request.time;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      
      // Creating User role (Self-registration allowed only for USER role without admin features initially or done via triggers)
      // Usually users register with normal role, only Admins can set others to higher roles
      allow create: if isSignedIn() 
                    && request.auth.uid == userId 
                    && isValidUser(incoming())
                    && incoming().email == request.auth.token.email
                    && incoming().role == 'USER';

      // Demo: explicitly allowing owner to modify their own role
      allow update: if (isAdmin() || isOwner(userId)) && isValidUser(incoming());
      allow delete: if isAdmin();

      function isOwner(uid) {
        return isSignedIn() && request.auth.uid == uid;
      }
    }

    match /tickets/{ticketId} {
      allow get: if isSignedIn() && (existing().buyerId == request.auth.uid || isAdmin() || isScanner());
      allow list: if isSignedIn() && (resource.data.buyerId == request.auth.uid || isAdmin());
      
      // In real life created by backend (Ozow hook), but if client creates:
      allow create: if isSignedIn() 
                    && isValidTicket(incoming())
                    && incoming().buyerId == request.auth.uid;
                    
      // Scanning the ticket
      allow update: if isSignedIn() 
                    && (isAdmin() || (isScanner() && incoming().diff(existing()).affectedKeys().hasOnly(['status']) && incoming().status == 'SCANNED'));
      
      allow delete: if isAdmin();
    }
  }
}
