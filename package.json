{
  "name": "bokamoso-arts-institute",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --target=node20 --outfile=build/server.cjs --external:express --external:vite",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "preview": "vite preview",
    "start": "node build/server.cjs",
    "clean": "rm -rf dist build",
    "lint": "tsc --noEmit",
    "test:rules": "npx -y firebase-tools@13 emulators:exec --only firestore --project demo-bai \"node --test tests/firestore.rules.test.mjs\"",
    "test": "npm run lint && npm run test:unit && npm run test:rules",
    "test:unit": "vitest run tests/content.test.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "cloudinary": "^2.10.0",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.0",
    "firebase": "^12.12.1",
    "firebase-admin": "^13.8.0",
    "helmet": "^8.1.0",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^0.546.0",
    "multer": "^1.4.5-lts.1",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.14.2",
    "tailwind-merge": "^3.5.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "esbuild": "^0.28.0",
    "gh-pages": "^6.3.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^5.1.0"
  }
}
